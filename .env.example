# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Optional: only sync slash commands to this guild while developing (faster)
# DEV_GUILD_ID=123456789012345678

# Server Members Intent must also be enabled in the Developer Portal.
MEMBERS_INTENT=true

# Local dashboard (http://127.0.0.1:8080)
DASHBOARD=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_SECRET=change-me

# Reload cogs when you save a file (no bot restart)
HOT_RELOAD=true
