# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Second Discord application — this bot joins voice and plays audio.
# Invite it to the same server with Connect + Speak. Yasunami never joins VC.
MUSIC_TOKEN=your_music_bot_token_here

# Optional: only sync slash commands to this guild while developing (faster)
# DEV_GUILD_ID=123456789012345678

MEMBERS_INTENT=true

DASHBOARD=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_SECRET=change-me

HOT_RELOAD=true
